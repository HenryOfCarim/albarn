    uint32 vertex_per_face;
    uint32 vert_a;
    uint32 vert_b;
    uint32 vert_c;
    uint32 num_neighbors;
    Neighbor neighbors[num_neighbors];
};


struct GridFace
{
    uint32 face_index;
    uint32 padding;
};

typedef struct GridCell
{
    uint32 num_faces;
    GridFace grid_faces[num_faces];
    
};



