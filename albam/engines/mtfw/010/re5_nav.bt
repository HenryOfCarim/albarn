struct FVector3
{
    float x;
    float y;
    float z;
};

struct FFlag
{
    uint32 a:8;
    uint32 b:8;
    uint32 c:8;
    uint32 d:8;
};

struct BBox
{
    float min[4];
    float max[4];
};

struct Neighbor
{
    uint32 face_index;
    uint32 padding;
    uint32 edge;
    float centroid_distance<fgcolor=0x7045c0>;

};


struct Face
{
    uint32 face_id;
    uint32 idb;
