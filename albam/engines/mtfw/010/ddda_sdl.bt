{
	unsigned int frame : 24 /* start 8 */ /* public */; // 0x00000000
	KeyMode mode : 8 /* start 0 */ /* public */; // 0x00000000
};
/*--------------------------------------------------*/
typedef struct Track //rScheduler::TRACK /* size : 0x00000018 */
{
	/*****************************************/
	/*****************************************/
	unsigned int track_type : 8 /* start 24 */ /* public */; // 0x00000000
	PropType prop_type : 8 /* start 16 */ /* public */; // 0x00000000
	unsigned int key_num : 16 /* start 0 */ /* public */; // 0x00000000
	//unsigned int parent_index /* public */; // 0x00000004
	uint32 prop_name_ofs /* probably wrong /public */; // 0x00000004 
	uint32 track_name_ofs /* public */; // 0x00000008
	//uint32 track_name /* public */; // 0x00000008
	//unsigned int prop_index /* public */; // 0x0000000c
	//unsigned int dti_id /* public */; // 0x0000000c
	//uint32 pdti /* public */; // 0x0000000c
	MtDTI dti_id /* public */; // 0x00000010
    uint key_frame_ofs;
    uint key_value_ofs;
    checkpoint = FTell();
    //FSeek(header.meta_data + prop_name_ofs);
    //char prop_name[];
    FSeek(header.meta_data + track_name_ofs);
    char track_name[];
    FSeek(checkpoint);
    if (key_frame_ofs != 0)
    {
        FSeek(key_frame_ofs);
        Key keyframe[key_num]<fgcolor=0x4570c0>;
        FSeek(checkpoint);
    };
    if (key_value_ofs != 0)
    {
        FSeek(key_value_ofs);
        switch(prop_type) 
        {
            case 0: uint     key0[key_num]<fgcolor=0x4520c0>; break;
            case 2: uint     classref_key2[key_num]<fgcolor=0x4520c0>; break;
            case 3: ubyte     bool_key3[key_num]<fgcolor=0x4520c0>; break;
            case 4: ubyte     u8_key4[key_num]<fgcolor=0x4520c0>; break;
            case 5: uint16     u16_key6[key_num]<fgcolor=0x4520b0>; break;
            case 6: uint32     u32_key6[key_num]<fgcolor=0x4520b0>; break;
            case 7: uint64    u64_key7[key_num]<fgcolor=0x4520b0>; break;
            case 8: byte     s8_key8[key_num]<fgcolor=0x4520b0>; break;
            case 9: int16     s15_key9[key_num]<fgcolor=0x4520b0>; break;
            case 10: int     s32_key10[key_num]<fgcolor=0x4520b0>; break;
            case 11: int64     s64_key10[key_num]<fgcolor=0x4520b0>; break;
            case 12: float     f32_key12[key_num]<fgcolor=0x4520b0>; break;
            case 14: char   string_key14[]<fgcolor=0x452090>; break;
            case 20: Vector3     vector3_key20[key_num]<fgcolor=0x4520b0>; break;
            case 21: Vector4     vector4_key21[key_num]<fgcolor=0x4520b0>; break;   
            case 28: uint     event_key28[key_num]<fgcolor=0x4520b0>; break;
            case 57: Key57    hermitecurve_key57[key_num]<fgcolor=0x4520b0>; break;
            case 128: Key128       path_128[key_num]<optimize= false, fgcolor=0x4520b0>; break;
        }
        FSeek(checkpoint);
    };
};

struct SDLHeader //  rScheduler::HEADER /* size : 0x0000002c */
{
    uint32 magic;
	ushort version /* public */; // 0x00000004
	ushort track_num /* public */; // 0x00000006
    uint32 crc;
    uint32 frame_max : 24;
    uint32 floor_frame: 1;
    uint32 reversed:7;
    uint32 base_track;
    uint32 meta_data;
};

