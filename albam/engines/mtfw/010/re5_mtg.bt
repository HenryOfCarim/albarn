struct MONTAGE_PARTS// rModelMontage::PARTS /* size : 0x00000008 */
{
	uint no : 16; // 0x00000000
	uint type : 16; // 0x00000000
	uint group; // 0x00000004
};

struct MONTAGE // rModelMontage::MONTAGE /* size : 0x00000014 */
{
	uint kind[4]; // 0x00000000
	float scale; // 0x00000010
};

typedef struct MTGHeader // rModelMontage::HEADER /* size : 0x00000018 */
{
    uint32 magic;
    uint32 version;
    uint32 parts_num ; // parts_num 
    uint32 montage_num; //  montage_num
    uint32 parts_ofc; // *parts
    uint32 montage_ofc; // *montage
    FSeek(parts_ofc);
    MONTAGE_PARTS render_groups[parts_num]<fgcolor=0x008080>;
    FSeek(montage_ofc);
    MONTAGE visibility_presets[montage_num]<fgcolor=0x808000>;
};

MTGHeader header<fgcolor=0x008000>;