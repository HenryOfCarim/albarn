struct Pair //When a face bounding box contains another face
{
    ushort face_01;
    ushort face_02;
    ubyte  quad_order[4]; //CommonEdge1(f1),CommonEdge2(f1),NoncommonEdge(f1),NoncommonEdge(f2)
    ushort type; //0 floor, 1 wall, 2 airwall
};


struct ColType
{
    float    unk_01;
    ushort   unk_02;
    ushort   unk_03;
    uint32   unk_04[3];
    char     jp_path[12];
};

struct Vector4F
{
    float x;
    float y;
    float z;
    float w;
};


struct Face
{
    float    normal[3];
    ushort   vert[3];
    ushort   type;
    uint32   nulls;
    ubyte    adjacent[3];
    ubyte    nulls_01;
    uint32   nulls_02;
};


struct BBox
{
    float min_x;
    float min_y;
    float min_z;
    float min_w;
    float max_x;
    float max_y;
    float max_z;
    float max_w;
};


struct AABB
{
    float x[4];
    float y[4];
    float z[4];
};


struct BvhNode
{
    ubyte node_type[4];
    ushort node_id[4];
    uint32 unk_05;
    AABB min_aabb;
    AABB max_aabb;


};

struct Bhv
{
    uint32 bvhc[2];
    uint32 soh;
    uint32 unk_01;
    BBox bounding_box;
    uint32 node_count;
    uint32 nulls[3];
    BvhNode nodes[node_count];
};


struct SBCInfo
{
    BBox bounding_box;
    uint32 unk_01;
    uint32 nulls_01[2];
    uint32 pairs_start;
    uint32 pairs_count;
    uint32 faces_start;
    uint32 face_count;
    uint32 vertex_start;
    uint32 vertex_count;
    uint32 index_id;
    uint32 nulls_02[2];
};


struct SBCFFHeader
{
    char magic[4];
    uint32 unk_00;
    uint32 unk_02;
    uint32 unk_03;
    ushort object_count;
    ushort stage_count;
    uint32 pair_count;
    uint32 face_count;
    uint32 vertex_count;
    uint32 nulls[4];
    BBox    bounding_box;
    //uint32 bb_size;
};


SBCFFHeader header<fgcolor=0x008000>;
SBCInfo     info[header.object_count]<bgcolor=0x7a5f1d>;
Pair        pairs[header.pair_count]<fgcolor=0xaf75c0>;
//uint32      unk_00[512]<bgcolor=0xca2080>;
//ushort      unk_01;
Face        faces[header.face_count]<bgcolor=0x788673>;
Vector4F    vertices[header.vertex_count]<bgcolor=0x4f4f2f>;
ColType     col_types[header.stage_count]<bgcolor=0x4d1220>;
Bhv         sbc_bvhc[header.object_count]<optimize=false, bgcolor=0x584571>;
Bhv         bvh<bgcolor=0x588045>;