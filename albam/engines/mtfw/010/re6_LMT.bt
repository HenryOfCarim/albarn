//------------------------------------------------
//--- 010 Editor v12.0.1 Binary Template
//
//      File: re5_LMT.bt
//   Authors: HenryVIII
//   Version: 0.3
//   Purpose: Parsing Resident evil 5 animation format
//  Category: Modding
// File Mask: lmt
//  ID Bytes: 4C 4D 54 00
//   History: 
//------------------------------------------------
local uint64 i<hidden=true>;
local uint64 j<hidden=true>;
local int64 savepos <hidden=true>;


enum Attributes//nMotion::MOTION_INFO::MOTION_ATTRIBUTE : __int32
{
  Default = 0x0,
  A_SCALE_GLOBAL = 0x1,
  A_SCALE_INHERIT_WDIR = 0x2,
  A_DIFF_MOTION = 0x4,
  A_NON_COMPRESS = 0x80,
};

enum Type //nMotion //::MOTION_PARAM::TYPE : __int32
{
  T_UNKNOWN = 0x0,
  T_VECTOR3_CONST = 0x1,
  T_QUATERNION3_CONST = 0x2,
  T_LINEARKEY = 0x3,
  T_LINEARKEY_16 = 0x4,
  T_LINEARKEY_8 = 0x5,
  T_POLAR3KEY = 0x6,
  T_POLAR3KEY_32 = 0x7,
  T_VECTOR3 = 0x8,
  T_QUATERNION4 = 0x9,
  T_POLAR3 = 0xA,
  T_QAXIS_X_32 = 0xB,
  T_QAXIS_Y_32 = 0xC,
  T_QAXIS_Z_32 = 0xD,
  T_QUATKEY_48 = 0xE,
  T_QUATKEY_40 = 0xF,
  T_HERMITE3 = 0x10,
  T_SMALLEST3 = 0x11,
  T_PARAM_TYPE_NUM = 0x12,
};


enum Usage //nMotion::MOTION_PARAM::USAGE : __int32
{
  U_QUATERNION = 0x0,
  U_TRANSLATE = 0x1,
  U_SCALE = 0x2,
  U_NULL_QUATERNION = 0x3,
  U_NULL_TRANSLATE = 0x4,
  U_NULL_SCALE = 0x5,
  U_NUM = 0x6,
};


struct Vec3
{
    float    x;
    float    y;
    float    z;
};

struct Vec4
{
    float x;
    float y;
    float z;
    float w;
};

struct Attribute
{
    uint16 group;
    ubyte frame;
};


struct LMTVec3
{
    Vec3 position;
};

struct LMTVec3Frame
{
    Vec3     position;
};

struct LMTVec3Frame16
{
    Vec3    position;
    uint    duration;
};

struct LMTVec3Frame_9
{
    Vec3     position;
    uint     duration;
};

struct LMTQuatized16Vec3
{
  ushort    position[3];
  ushort    duration;  
};


struct LMTQuatized32Quat
{
    uint    var1;
};

struct LMTQuatized8Vec3
{
    ubyte position[3];
    ubyte duration;
};

struct LMTQuat3Frame
{
    Vec3     position;
};

struct LMTQuatFramev14
{
    uint     var1;
    uint     var2;
};

struct LMTXWQuat
{
    uint     var1;
};

struct LMTYWQuat
{
    uint    var1;
};

struct LMTZWQuat
{
    uint     var1;
};

struct LMTQuatized11Quat
{
    ushort   var1;
    ushort   var2;
    ushort   var3;
};

struct LMTQuatized9Quat
{
    ubyte    var1;
    ubyte    var2;
    ubyte    var3;
    ubyte    var4;
    ubyte    var5;
};

struct LMTHeader
{
    char id_magic[4];
    ushort version; //67 for 211
    ushort num_blocks;
    //uint block_offsets[num_blocks]; //there is 0 fill after
};

struct SFX
{
    uint16 sfx_id;
};

struct FrameBound // MOTION_PARAM_EX ?
{
    float addin[4];
    float offset[4];
};


struct FrameData // MOTION_PARAM
{
    ubyte    buffer_type;//BufferType
    ubyte    usage;//Usage
    ubyte    joint_type;//JoinType
    ubyte    bone_index;//boneID
    float    weight;// weight ?
    uint     buffer_size;//BufferSize
    uint     buffer_offset;//BufferOffset
    Vec4     reference_data;//BufferRef
    uint     ofs_bounds;
    local int64 checkpoint = FTell();
    if (ofs_bounds>0)
        FSeek(ofs_bounds);
        FrameBound frame_bounds<bgcolor=0x5a2a50>;
    FSeek(checkpoint);
    
    if(buffer_size>0)
    {
        struct
        {
            FSeek(buffer_offset);
            switch(buffer_type)
            {
                case 1:     LMTVec3             frames_01<fgcolor=0xff5682>; break; //one frame 
                case 2:     LMTVec3Frame        frames_02[(buffer_size/12)]<fgcolor=0xffb156>; break;
                case 3:     LMTVec3Frame16      frames_03[(buffer_size/16)]<fgcolor=0xffc156>; break; //the code is unclear, probably size = 16
                case 4:     LMTQuatized16Vec3   frames_04[(buffer_size/8)]<fgcolor=0xccb345>; break; // different in RE5
                case 5:     LMTQuatized8Vec3    frames_05[(buffer_size/4)]<fgcolor=0xa2ad3b>; break; // different in RE5
                case 6:     LMTQuatFramev14     frames_06[(buffer_size/8)]<fgcolor=0xff8090>; break;
                case 7:     LMTQuatized32Quat   frames_07[(buffer_size/4)]<fgcolor=0x5b6121>; break;
                case 9:     LMTVec3Frame16      frames_09[(buffer_size/16)]<fgcolor=0xe0ff5f>; break;
                case 11:    LMTXWQuat           frames_11[(buffer_size/4)]<fgcolor=0x4db3cf>; break;
                case 12:    LMTYWQuat           frames_12[(buffer_size/4)]<fgcolor=0x3f92a9>; break;
                case 13:    LMTZWQuat           frames_13[(buffer_size/4)]<fgcolor=0x354ddf>; break;
                case 14:    LMTQuatized11Quat   frames_14[(buffer_size/6)]<fgcolor=0x435393>; break;
                case 15:    LMTQuatized9Quat    frames_15[(buffer_size/5)]<fgcolor=0x1a268d>; break;
            };
            //ubyte   data[buffer_size];
        }frame_data_body<fgcolor=cRed>;
    };
    FSeek(checkpoint);
};


struct Attr
{
    uint group;
    uint frame;
};


struct SequenceInfo //SEQUENCE_INFO
{
    uint16 work[32];
    uint num_seq;
    uint ofs_seq;
    local int64 checkpoint_02 = FTell();
    FSeek(ofs_seq);
    Attr attributes[num_seq]<bgcolor=0x8050c0>;
    FSeek(checkpoint_02);
};


struct KeyInfo // KEYINFO_U32;
{
    uint unk_01;
    uint unk_02;
    uint unk_03;
    uint unk_04;
};


typedef struct KeyframeInfo
{
    uint type : 8;
    uint work : 16;
    uint attr : 8;
    uint num_key;
    uint unk_ofs;
    local int64 checkpoint_01 = FTell();
    if (unk_ofs>0)
    {
        FSeek(unk_ofs);
        KeyInfo info[num_key]<fgcolor=0x577806>;
    };    
    FSeek(checkpoint_01);

};


struct Track //LMTAniBlockHeader
{
    uint     ofs_frame; //Offset
    uint     num_bones; //BoneCount
    uint     num_frames; //FrameCount
    int      loop_frame; //LoopFrame
    Vec3     init_position;
    float    padding;
    Vec4     init_quaternion;
    Attributes     attr:16;
    uint     kf_num:5;
    uint     seq_num:3;
    uint     duplicate:3;
    uint     reserved:5;
    uint     ofs_buffer_01; //SEQUENCE_INFO
    uint     ofs_buffer_02; //KEYFRAME_INFO 
    local uint64 savepos = FTell();
    if (ofs_buffer_01>0)
    {
        FSeek(ofs_buffer_01);
        SequenceInfo  anim_attributes[seq_num]<optimize=false, fgcolor=0x577806>;
    };
    FSeek(savepos);
    if (ofs_buffer_02>0)
    {
        FSeek(ofs_buffer_02);
        KeyframeInfo keyframe_info[kf_num]<optimize=false, fgcolor=0x5778c6>;
    };
    FSeek(savepos);
    struct
    {
        FSeek(ofs_frame);
        FrameData   frame_data[num_bones]<optimize=false,fgcolor=cGreen>;
    }frames;
    FSeek(savepos);
};


typedef struct AnimBlock //MOTION_INFO
{
    uint offset<fgcolor=0x855080>;
    if (offset > 0)
    {
        local uint64 checkpoint = FTell();
        FSeek(offset);
        Track    track<fgcolor=0xabbb82>;
        FSeek(checkpoint);
    };
};

LMTHeader lmt_header<fgcolor=cYellow>;
AnimBlock anim_block[lmt_header.num_blocks]<optimize=false>;
