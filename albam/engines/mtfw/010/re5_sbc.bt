//  Category: Modding 
// File Mask: .sbc
//  ID Bytes: 53 42 43 31
//------------------------------------------------
struct BBox
{
    float min_x;
    float min_y;
    float min_z;
    float max_x;
    float max_y;
    float max_z;
};

struct BBox4
{
    float min_x;
    float min_y;
    float min_z;
    float min_w;
    float max_x;
    float max_y;
    float max_z;
    float max_w;
};

struct Vertex
{
    float x;
    float y;
    float z;
    float w;
};

struct FaceVerts
{
    uint16 vert_index_00;
    uint16 vert_index_01;
    uint16 vert_index_02;
};

struct SBC1Head // rCollision::Header
{
    char    id_magic[4];//handle
    uint16  version; //sbcNo
    uint16  num_sbc_group;//node_no
    uint16  num_sbc_group_nodes;//
    ubyte   max_parts_nest_count;
    ubyte   max_nest_count;
    uint32  num_bboxes;
    uint32  num_faces;
    uint32  num_vertices;
    BBox bbox;
};

struct BVHNode // rCollision::Node
{
    BBox4 box_a;
    BBox4 box_b;
    uint16 bit;
    uint16 child_index[2];
    //uint32 unk_03;// parent node?
    ubyte nulls[10];
};
    
struct SBCgroup //rCollision::PartsInfo 96 bytes 
{
    uint32 base; //  u32 Flags
    uint32 ofs_tris; // u32 TriangleIndex;
    uint32 ofs_boxes; //u32 NodeIndex;
    uint32 ofs_verts; //u32 VertexIndex;
    uint32 group_id; //
    BBox a;
    BBox b; // b and c boxes don't look like bounding boxes
    BBox c;
    uint16 child_index[2];
};

struct SBCFace // 28 bytes 
{
    FaceVerts face_verts<bgcolor=0xA6F10>;
    ubyte unk_00<bgcolor=0x50c020>; // 
    ubyte unk_01<bgcolor=0x50c020>; //
    uint32 runtime_attr<bgcolor=0x20c0c0>;
    uint32 type<bgcolor=0x2050c0>;//more than 0 only in _eff
    uint32 special_attr;
    uint32 surface_attr;
    uint32 unk_02;
};

SBC1Head header<bgcolor=0x4b1c4a>;
if(header.id_magic == "SBC1")
{
    BVHNode bvh_nodes[header.num_bboxes]<bgcolor=0x7a5f1d>;
    SBCgroup groups[header.num_sbc_group]<bgcolor=0x584571>;
    SBCFace faces[header.num_faces];
    Vertex vertices[header.num_vertices]<bgcolor=0x4f4f2f>;
};