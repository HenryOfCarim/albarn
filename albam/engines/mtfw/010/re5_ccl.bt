//   Version: 0.3
//   Purpose: parsing RE5 chain collision format 
//  Category: 
// File Mask: 
//  ID Bytes: 43 43 4c 00
//   History: 
//------------------------------------------------
enum COL_ATTR // rChainCol::ColInfo::COLLISION_ATTRIBUTE /* int */
{
	COL_ATTR_ATTACHED = 0x1,
};

enum <ubyte> COL_SHAPE// rChainCol::ColInfo::COLLISION_SHAPE /* int */
{
	SHAPE_SPHERE = 0x0,
	SHAPE_CAPSULE = 0x1,
	SHAPE_AABB = 0x2,
	SHAPE_OBB = 0x3,
};

struct CCLHeader // ChainCol::Header 
{
    uint magic;
    uint id;
    uint block_num;
    uint size;
};

struct VectorF3
{
    float x;
    float y;
    float z;
};

struct ColInfo // ColInfo  size : 0x00000040
{
    COL_ATTR    attr;
    ushort      ref_joint_no; // 0x00000004 anim index
    ushort      pair_joint_no; // 0x00000006 anim index
    COL_SHAPE       shape; // 0x00000008
    uchar       reserve[3]; // 0x00000009
    float       reserve1; //0x0000000c
    VectorF3    position; //0x00000010
    uint        id; // 0x0000001c
    VectorF3    extent; //0x0000002c
    float       radius; // 0x0000002c
    VectorF3    angle; // 0x00000030
    float      reserve2; // 0x0000003c
};


CCLHeader header<bgcolor=0x613340>;
ColInfo data_blocks[header.block_num]<bgcolor=0x5f6935>;